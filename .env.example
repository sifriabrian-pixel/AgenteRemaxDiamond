# === Google Sheets — sistema de guardias ===
# Solo aplica a HANDOFF_PROPIETARIO / HANDOFF_GENERAL (leads sin propiedad puntual).
# PENDIENTE: confirmar si Diamond usa guardia por turno para estos casos, o si también
# van directo a WHATSAPP_BACKUP (ver sección 5 de SPEC.md).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# === Catálogo de propiedades ===
# Ya NO se lee de Google Sheets — se genera con scripts/importar-propiedades.js
# a partir del export del MLS + data/asesores.json. Ver SPEC.md sección 3.

# === Números de derivación ===
WHATSAPP_RECLUTAMIENTO=
WHATSAPP_GRUPO_RECLUTAMIENTO=
# Número de la oficina que atiende Grace. Recibe: leads de comprador/arrendatario
# sin propiedad puntual asignada, y TODOS los leads de propietario/captación y
# consultas generales (HANDOFF_PROPIETARIO / HANDOFF_GENERAL).
WHATSAPP_BACKUP=

# === Overrides de guardia (!guardia) ===
NUMEROS_AUTORIZADOS=

# === Dashboard ===
DASHBOARD_PASSWORD=

# === Servidor ===
PORT=3000
